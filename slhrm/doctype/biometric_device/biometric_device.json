{
 "name": "Biometric Device",
 "module": "SLHRM",
 "doctype": "DocType",
 "document_type": "Setup",
 "issingle": 0,
 "istable": 0,
 "is_submittable": 0,
 "track_changes": 1,
 "autoname": "field:serial",
 "naming_rule": "By fieldname",
 "title_field": "device_name",
 "show_title_field_in_link": 1,
 "search_fields": "device_name,branch",
 "sort_field": "modified",
 "sort_order": "DESC",
 "modified": "2026-11-12 12:00:00.000000",
 "fields": [
  {
   "fieldname": "serial",
   "fieldtype": "Data",
   "label": "Serial Number",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1,
   "description": "Read from the device by the SLHRM agent (get_serialnumber). The document name."
  },
  {
   "fieldname": "device_name",
   "fieldtype": "Data",
   "label": "Device Name",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "branch",
   "fieldtype": "Link",
   "label": "Branch",
   "options": "Branch",
   "in_list_view": 1,
   "description": "Device user ids are matched to Employee Attendance Device ID (all devices) company-wide; employees of a branch this device does not serve are matched as 'other branch' (report Device Users Other Branch). The employee-number fallback looks only in the served branches."
  },
  {
   "fieldname": "served_branches",
   "fieldtype": "Table",
   "label": "Served Branches",
   "options": "Biometric Device Branch",
   "description": "Branches whose employees punch on this device (always includes the device's own Branch). Device user ids must be unique across these branches."
  },
  {
   "fieldname": "blocked_user_ids",
   "fieldtype": "Table",
   "label": "Blocked User IDs",
   "options": "Biometric Device Blocked User",
   "description": "Device user ids of THIS device that are never matched to an employee (e.g. the same number belongs to another person on another device). Their punches stay Unmatched with the reason; re-enrol the person on the device with a free number, then remove the row."
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled",
   "default": "1",
   "in_list_view": 1,
   "description": "Punches of a disabled device are refused."
  },
  {
   "fieldname": "column_break_conn",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "ip",
   "fieldtype": "Data",
   "label": "IP Address"
  },
  {
   "fieldname": "port",
   "fieldtype": "Int",
   "label": "Port",
   "default": "4370"
  },
  {
   "fieldname": "timezone",
   "fieldtype": "Data",
   "label": "Device Clock Timezone",
   "reqd": 1,
   "default": "Asia/Colombo",
   "description": "IANA timezone of the device clock (e.g. Asia/Colombo). Punch times are converted to the site timezone."
  },
  {
   "fieldname": "section_connection",
   "fieldtype": "Section Break",
   "label": "Connection"
  },
  {
   "fieldname": "connection_status",
   "fieldtype": "Select",
   "label": "Connection Status",
   "read_only": 1,
   "options": "\nOnline\nDelayed\nOffline\nDisabled",
   "in_standard_filter": 1,
   "description": "Online: last successful read ≤ 10 min ago. Delayed: 10–60 min, or a timeout (fewer than 3 failed runs in a row). Offline: > 60 min, a connect / password failure, or 3 failed runs in a row. Computed on the server from the agent's heartbeats (no device access from the web)."
  },
  {
   "fieldname": "last_success_at",
   "fieldtype": "Datetime",
   "label": "Last successful sync",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "last_read_seconds",
   "fieldtype": "Float",
   "label": "Last read (s)",
   "read_only": 1,
   "precision": "1"
  },
  {
   "fieldname": "column_break_conn2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "last_error_at",
   "fieldtype": "Datetime",
   "label": "Last error at",
   "read_only": 1
  },
  {
   "fieldname": "last_error_kind",
   "fieldtype": "Data",
   "label": "Last error kind",
   "read_only": 1,
   "description": "timeout / connect / auth / read (from the agent)."
  },
  {
   "fieldname": "consecutive_failures",
   "fieldtype": "Int",
   "label": "Failed runs in a row",
   "read_only": 1
  },
  {
   "fieldname": "offline_notified",
   "fieldtype": "Check",
   "label": "Offline notified",
   "read_only": 1,
   "hidden": 1
  },
  {
   "fieldname": "section_sync",
   "fieldtype": "Section Break",
   "label": "Sync Now",
   "collapsible": 1
  },
  {
   "fieldname": "sync_requested",
   "fieldtype": "Check",
   "label": "Sync requested",
   "read_only": 1,
   "description": "Set by Sync Now, cleared when the agent has run. If the agent ever runs on a site LAN box instead of this server, it picks up this flag (code path kept ready)."
  },
  {
   "fieldname": "sync_requested_by",
   "fieldtype": "Link",
   "options": "User",
   "label": "Sync requested by",
   "read_only": 1
  },
  {
   "fieldname": "sync_requested_at",
   "fieldtype": "Datetime",
   "label": "Sync requested at",
   "read_only": 1
  },
  {
   "fieldname": "column_break_sync",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "last_sync_result",
   "fieldtype": "Code",
   "options": "JSON",
   "label": "Last Sync Now result",
   "read_only": 1
  },
  {
   "fieldname": "section_info",
   "fieldtype": "Section Break",
   "label": "Device Info (read by the agent)",
   "collapsible": 1
  },
  {
   "fieldname": "platform",
   "fieldtype": "Data",
   "label": "Platform / Model",
   "read_only": 1
  },
  {
   "fieldname": "firmware",
   "fieldtype": "Data",
   "label": "Firmware",
   "read_only": 1
  },
  {
   "fieldname": "column_break_info",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "mac",
   "fieldtype": "Data",
   "label": "MAC Address",
   "read_only": 1
  },
  {
   "fieldname": "device_reported_name",
   "fieldtype": "Data",
   "label": "Name Reported by Device",
   "read_only": 1
  },
  {
   "fieldname": "section_health",
   "fieldtype": "Section Break",
   "label": "Health (agent heartbeat)"
  },
  {
   "fieldname": "last_heartbeat",
   "fieldtype": "Datetime",
   "label": "Last Heartbeat",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "last_pull",
   "fieldtype": "Datetime",
   "label": "Last Device Read",
   "read_only": 1
  },
  {
   "fieldname": "last_pull_ok",
   "fieldtype": "Check",
   "label": "Last Device Read OK",
   "read_only": 1
  },
  {
   "fieldname": "clock_drift_seconds",
   "fieldtype": "Float",
   "label": "Clock Drift (s)",
   "read_only": 1,
   "description": "Device clock minus the agent's NTP-synced clock, in the device timezone. Positive = device ahead.",
   "in_list_view": 1
  },
  {
   "fieldname": "agent",
   "fieldtype": "Data",
   "label": "Agent",
   "read_only": 1
  },
  {
   "fieldname": "column_break_health",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "user_count",
   "fieldtype": "Int",
   "label": "Users",
   "read_only": 1
  },
  {
   "fieldname": "user_capacity",
   "fieldtype": "Int",
   "label": "User Capacity",
   "read_only": 1
  },
  {
   "fieldname": "record_count",
   "fieldtype": "Int",
   "label": "Attendance Records",
   "read_only": 1
  },
  {
   "fieldname": "record_capacity",
   "fieldtype": "Int",
   "label": "Record Capacity",
   "read_only": 1
  },
  {
   "fieldname": "queue_depth",
   "fieldtype": "Int",
   "label": "Agent Queue (not yet confirmed)",
   "read_only": 1
  },
  {
   "fieldname": "last_error",
   "fieldtype": "Small Text",
   "label": "Last Error",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1
  },
  {
   "role": "HR Manager",
   "read": 1,
   "write": 1,
   "create": 1
  },
  {
   "role": "HR User",
   "read": 1
  }
 ]
}
